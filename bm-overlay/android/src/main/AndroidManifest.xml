<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bairimeng.overlay">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application>
        <!-- 锁机无障碍服务：番茄钟专注锁机期间拦截 Home/返回/最近任务键。
             注意：无障碍服务必须能被系统无障碍框架绑定，不能 exported="false"，
             靠 BIND_ACCESSIBILITY_SERVICE 权限（仅系统可授予）保护安全。 -->
        <service
            android:name="com.bairimeng.overlay.BmLockAccessibilityService"
            android:label="@string/bm_lock_accessibility_desc"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
